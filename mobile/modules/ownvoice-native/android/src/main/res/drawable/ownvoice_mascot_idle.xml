<?xml version="1.0" encoding="utf-8"?>
<!-- Ownvoice mascot idle loop: bob and breathe every 3 s, glance at the chat, blink. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp" android:height="48dp"
            android:viewportWidth="120" android:viewportHeight="120">
            <group android:name="bob">
                <group android:name="squash" android:pivotX="60" android:pivotY="110">
                    <path android:pathData="M60 14 C69 31 98 48 98 77 A38 38 0 0 1 22 77 C22 48 51 31 60 14 Z"
                        android:fillColor="@color/ownvoice_mascot_body"
                        android:strokeColor="@color/ownvoice_mascot_body"
                        android:strokeWidth="5"
                        android:strokeLineJoin="round" />
                    <path android:pathData="M40 50 Q33 60 32.5 70"
                        android:strokeColor="@color/ownvoice_mascot_shine"
                        android:strokeWidth="4.2"
                        android:strokeAlpha="0.55"
                        android:strokeLineCap="round" />
                    <path android:pathData="M34.50,84.50a6.00,3.40 0,1 0,12.00,0a6.00,3.40 0,1 0,-12.00,0Z"
                        android:fillColor="@color/ownvoice_mascot_blush"
                        android:fillAlpha="0.90" />
                    <path android:pathData="M73.50,84.50a6.00,3.40 0,1 0,12.00,0a6.00,3.40 0,1 0,-12.00,0Z"
                        android:fillColor="@color/ownvoice_mascot_blush"
                        android:fillAlpha="0.90" />
                    <path android:pathData="M54.00 85.00 Q60.00 90.50 66.00 85.00"
                        android:strokeColor="@color/ownvoice_mascot_ink"
                        android:strokeWidth="3.2"
                        android:strokeLineCap="round"
                        android:strokeLineJoin="round" />
                    <group android:name="look">
                        <group android:name="eye_left" android:pivotX="47.00" android:pivotY="76.00">
                            <path android:pathData="M42.40,76.00a4.60,6.20 0,1 0,9.20,0a4.60,6.20 0,1 0,-9.20,0Z"
                                android:fillColor="@color/ownvoice_mascot_ink" />
                            <path android:pathData="M43.97,73.64a1.56,1.56 0,1 0,3.12,0a1.56,1.56 0,1 0,-3.12,0Z"
                                android:fillColor="@color/ownvoice_mascot_shine" />
                        </group>
                        <group android:name="eye_right" android:pivotX="73.00" android:pivotY="76.00">
                            <path android:pathData="M68.40,76.00a4.60,6.20 0,1 0,9.20,0a4.60,6.20 0,1 0,-9.20,0Z"
                                android:fillColor="@color/ownvoice_mascot_ink" />
                            <path android:pathData="M69.97,73.64a1.56,1.56 0,1 0,3.12,0a1.56,1.56 0,1 0,-3.12,0Z"
                                android:fillColor="@color/ownvoice_mascot_shine" />
                        </group>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="bob">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate">
            <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="0" />
                <keyframe android:fraction="1.000" android:value="-2.2" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="squash">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate">
            <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="1.025" />
                <keyframe android:fraction="1.000" android:value="0.975" />
            </propertyValuesHolder>
            <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="0.976" />
                <keyframe android:fraction="1.000" android:value="1.026" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="look">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3000" android:repeatCount="infinite">
            <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="0" />
                <keyframe android:fraction="0.300" android:value="0" />
                <keyframe android:fraction="0.360" android:value="1.8" />
                <keyframe android:fraction="0.620" android:value="1.8" />
                <keyframe android:fraction="0.680" android:value="0" />
                <keyframe android:fraction="1.000" android:value="0" />
            </propertyValuesHolder>
            <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="0.0" />
                <keyframe android:fraction="0.300" android:value="0.0" />
                <keyframe android:fraction="0.360" android:value="0.4" />
                <keyframe android:fraction="0.620" android:value="0.4" />
                <keyframe android:fraction="0.680" android:value="0.0" />
                <keyframe android:fraction="1.000" android:value="0.0" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="eye_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3000" android:repeatCount="infinite">
            <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="1" />
                <keyframe android:fraction="0.820" android:value="1" />
                <keyframe android:fraction="0.850" android:value="0.12" />
                <keyframe android:fraction="0.880" android:value="1" />
                <keyframe android:fraction="1.000" android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="eye_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3000" android:repeatCount="infinite">
            <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                <keyframe android:fraction="0.000" android:value="1" />
                <keyframe android:fraction="0.820" android:value="1" />
                <keyframe android:fraction="0.850" android:value="0.12" />
                <keyframe android:fraction="0.880" android:value="1" />
                <keyframe android:fraction="1.000" android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
