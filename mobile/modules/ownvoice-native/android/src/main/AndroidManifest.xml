<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- The only network use besides ChatGPT-by-choice: the one-time on-device model download. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Only the kit's window-host path uses these; Ownvoice rides its own accessibility
    service instead, so the kit's unused entries never merge in. (SYSTEM_ALERT_WINDOW stays:
    Expo's own app template declares it, and removing that pre-existing entry is not this change.) -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <uses-native-library android:name="libOpenCL.so" android:required="false" />
    <!-- The drafts panel: a see-through React Native screen, so Ownvoice is the app in front while the phone's model runs. -->
    <activity
        android:name="dev.ownvoice.bridge.PanelActivity"
        android:excludeFromRecents="true"
        android:exported="false"
        android:taskAffinity="dev.ownvoice.drafts"
        android:theme="@style/OwnvoicePanel" />
    <!-- Selected-text rewrite: "Ownvoice" in the text-selection menu, or Share of a piece of text. -->
    <activity
        android:name="dev.ownvoice.bridge.RewriteActivity"
        android:label="Ownvoice"
        android:excludeFromRecents="true"
        android:exported="true"
        android:taskAffinity="dev.ownvoice.rewrite"
        android:theme="@style/OwnvoicePanel">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/markdown" />
        <data android:mimeType="text/x-markdown" />
      </intent-filter>
    </activity>
    <service
        android:name="dev.ownvoice.bridge.OwnvoiceService"
        android:exported="false"
        android:label="Ownvoice"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/ownvoice_service" />
    </service>
  </application>
</manifest>
