{
  "name": "ownvoice-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Ownvoice pure writing core (model-free checks, prompts and parsers). No store, source, readLog, switch, writers, chatgpt or native code.",
  "type": "module",
  "bin": {
    "ownvoice-engine": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./protocol/schema.json": "./protocol/schema.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.mjs\"",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "typescript": "~5.9.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "protocol/schema.json",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/ownvoice.git",
    "directory": "packages/engine"
  },
  "engines": {
    "node": ">=18"
  }
}
